# URL de conexão com o Postgres (porta 5433 no host)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/roteirize

# Em banco remoto a URL precisa do sslmode, senão o pg conecta sem TLS:
# DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=verify-full

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Origem do front-end liberada no CORS (sem barra no final)
CORS_ORIGIN=http://localhost:5173
